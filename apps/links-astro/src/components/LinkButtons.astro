---
import type { ProfileLink } from '../types';

interface Props {
  links: ProfileLink[];
}

const { links } = Astro.props;

function getIconType(link: ProfileLink) {
  const labelLower = link.label.toLowerCase();
  const iconLower = link.icon?.toLowerCase() || '';

  if (labelLower.includes('portfolio') || iconLower.includes('portfolio')) return 'briefcase';
  if (labelLower.includes('blog') || iconLower.includes('blog')) return 'book-open';
  if (labelLower.includes('resume') || labelLower.includes('cv') || iconLower.includes('resume')) return 'file-text';
  if (labelLower.includes('project') || iconLower.includes('code')) return 'code';
  if (labelLower.includes('website') || iconLower.includes('website')) return 'globe';
  return 'globe';
}

// Simple SVGs for Lucide icons
const icons = {
  briefcase: `<rect width="20" height="14" x="2" y="6" rx="2" /><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />`,
  'book-open': `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />`,
  'file-text': `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />`,
  code: `<polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />`,
  globe: `<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />`,
  'external-link': `<path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />`
};
---

<div class="w-full flex flex-col gap-4 md:gap-5">
  {links.map((link, index) => {
    const iconType = getIconType(link);
    const svgPath = icons[iconType as keyof typeof icons] || icons.globe;
    const delay = `${index * 0.1}s`;

    return (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center p-4 md:py-5 md:px-6 bg-surface rounded-container shadow-neu-extruded hover:shadow-neu-extruded-hover active:shadow-neu-inset transition-all duration-300 transform hover:-translate-y-1"
        style={`animation-delay: ${delay}`}
      >
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-surface shadow-neu-inset flex items-center justify-center mr-4 text-accent group-hover:scale-110 transition-transform duration-300">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5 md:w-6 md:h-6"
            set:html={svgPath}
          />
        </div>
        <span class="flex-1 font-semibold text-center text-base md:text-lg text-foreground/90 group-hover:text-foreground transition-colors duration-300 font-sans">
          {link.label}
        </span>
        <div class="w-10 flex justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 md:w-5 md:h-5 text-foreground-muted opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-0.5"
            set:html={icons['external-link']}
          />
        </div>
      </a>
    );
  })}
</div>
