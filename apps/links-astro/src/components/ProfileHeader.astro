---
interface Props {
  name: string;
  bio: string;
  avatarUrl?: string;
  tagline?: string;
}

const { name, bio, avatarUrl, tagline } = Astro.props;
const initial = name.charAt(0).toUpperCase();
---

<div class="flex flex-col items-center gap-5 md:gap-7 py-8 md:py-10">
  <div class="relative">
    <div class="md:scale-125 relative rounded-full p-2 bg-surface shadow-neu-extruded transition-transform duration-300">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden bg-surface shadow-neu-inset flex items-center justify-center">
        {avatarUrl ? (
          <img
            src={avatarUrl}
            alt={name}
            width="120"
            height="120"
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-4xl font-bold bg-gradient-to-br from-accent to-accent-light text-white">
            {initial}
          </div>
        )}
      </div>
    </div>
    <div class="absolute -bottom-1 -right-1 bg-surface p-1.5 rounded-full shadow-neu-extruded-sm animate-bounce duration-1000">
      <span class="text-lg">👋</span>
    </div>
  </div>

  <div class="text-center space-y-3 md:space-y-4">
    <h1 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight font-display">{name}</h1>
    {tagline && (
      <p class="text-lg md:text-xl font-medium text-accent">{tagline}</p>
    )}
    <p class="text-base md:text-lg text-foreground-muted max-w-xs md:max-w-md mx-auto leading-relaxed">
      {bio}
    </p>
  </div>

  <div class="md:scale-110 flex items-center gap-2 px-4 py-2 bg-surface rounded-full shadow-neu-extruded-sm">
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.6)]" />
    <span class="text-sm md:text-base text-foreground-muted font-medium">
      Available for work
    </span>
  </div>
</div>
