---
interface Props {
  name: string;
  bio: string;
  avatarUrl?: string;
  tagline?: string;
}

const { name, bio, avatarUrl, tagline } = Astro.props;
const initial = name.charAt(0).toUpperCase();
---

<div class="homepage-reveal flex flex-col items-center gap-4 py-5 md:gap-5 md:py-6">
  <div class="relative">
    <div class="homepage-reveal-pop relative rounded-full bg-surface p-2 shadow-neu-extruded transition-transform duration-300 md:scale-110">
      <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden bg-surface shadow-neu-inset flex items-center justify-center">
        {avatarUrl ? (
          <img
            src={avatarUrl}
            alt={name}
            width="120"
            height="120"
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-3xl font-bold bg-gradient-to-br from-accent to-accent-light text-white md:text-4xl">
            {initial}
          </div>
        )}
      </div>
    </div>
    <div class="absolute -bottom-1 -right-1 rounded-full bg-surface p-1.5 shadow-neu-extruded-sm animate-bounce duration-1000">
      <span class="text-base md:text-lg">👋</span>
    </div>
  </div>

  <div class="text-center space-y-2.5 md:space-y-3">
    <h1 class="homepage-reveal-soft text-xl font-bold tracking-tight text-foreground font-display md:text-2xl" style="animation-delay: 0.08s">{name}</h1>
    {tagline && (
      <p class="homepage-reveal-soft text-base font-medium text-accent md:text-lg" style="animation-delay: 0.14s">{tagline}</p>
    )}
    <p class="homepage-reveal-soft mx-auto max-w-sm text-sm leading-7 text-foreground-muted md:max-w-lg md:text-base" style="animation-delay: 0.2s">
      {bio}
    </p>
  </div>

  <div class="homepage-reveal-soft flex items-center gap-2 rounded-full bg-surface px-3.5 py-2 shadow-neu-extruded-sm" style="animation-delay: 0.28s">
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.6)]" />
    <span class="text-xs md:text-sm text-foreground-muted font-medium">
      Available for work
    </span>
  </div>
</div>
