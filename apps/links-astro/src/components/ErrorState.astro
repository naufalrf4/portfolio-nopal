---
interface Props {
  title?: string;
  message: string;
}

const { title = 'Failed to load links', message } = Astro.props;---

<div class="flex flex-col items-center justify-center py-12 px-4 text-center w-full max-w-md mx-auto">
  <div class="rounded-full p-6 mb-6 bg-surface shadow-neu-extruded">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="48"
      height="48"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-12 w-12 text-red-500"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" x2="12" y1="8" y2="12"></line>
      <line x1="12" x2="12.01" y1="16" y2="16"></line>
    </svg>
  </div>

  <h1 class="text-xl font-semibold text-foreground mb-2">{title}</h1>
  <p class="text-foreground-muted mb-6 max-w-sm leading-relaxed">{message}</p>

  <button
    type="button"
    class="flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-white transition-all duration-300 bg-accent shadow-neu-extruded hover:shadow-neu-extruded-hover"
    onclick="window.location.reload()"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-4 h-4"
    >
      <path d="M21 2v6h-6"></path>
      <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
      <path d="M3 22v-6h6"></path>
      <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
    </svg>
    Try Again
  </button>
</div>
