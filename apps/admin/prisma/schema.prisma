generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  image            String?
  role             UserRole         @default(USER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  guestbookEntries GuestbookEntry[]
  sessions         Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  summary     String
  description String
  category    String
  techStack   String[]
  tags        String[]
  liveUrl     String?
  repoUrl     String?
  imageUrl    String?
  featured    Boolean          @default(false)
  visible     Boolean          @default(true)
  order       Int              @default(0)
  startDate   DateTime?
  endDate     DateTime?
  projectDate String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  content     String?
  thumbnailId String?
  contexts    ProjectContext[]
  images      ProjectImage[]

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([visible])
  @@index([order])
  @@map("projects")
}

model ProjectContext {
  id        String             @id @default(cuid())
  projectId String
  type      ProjectContextType
  title     String
  content   String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([order])
  @@map("project_contexts")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  key       String
  order     Int      @default(0)
  caption   String?
  alt       String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
  @@map("project_images")
}

model BlogLink {
  id          String   @id @default(cuid())
  url         String
  title       String
  description String?
  imageUrl    String?
  source      String   // e.g., "Medium", "Dev.to", "Personal Blog"
  category    String?
  tags        String[]
  publishedAt DateTime
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuestbookEntry {
  id          String   @id @default(cuid())
  userId      String
  message     String
  reactions   Json     @default("[]")
  visible     Boolean  @default(true)
  ipAddress   String?
  countryCode String?
  country     String?
  city        String?
  region      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([visible])
  @@index([createdAt])
  @@index([countryCode])
  @@map("guestbook_entries")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  page        String   @db.VarChar(100)
  entityType  String   @db.VarChar(50)
  entityId    String?
  eventType   String   @db.VarChar(20)
  data        Json?
  userSession String?
  ipAddress   String?  @db.VarChar(45)
  countryCode String?  @db.VarChar(2)
  city        String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@index([page])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("analytics_events")
}

model AnonymousMessage {
  id          String   @id @default(cuid())
  content     String
  ipHash      String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  city        String?
  country     String?
  countryCode String?
  ipAddress   String?
  region      String?

  @@index([read])
  @@index([createdAt])
  @@index([countryCode])
  @@index([city])
  @@map("anonymous_messages")
}

model ChatLog {
  id        String   @id @default(cuid())
  sessionId String   @unique
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_logs")
}

model ProfileLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  icon      String?
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible])
  @@index([order])
  @@map("profile_links")
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  filename  String   @unique
  content   String
  indexed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filename])
  @@index([indexed])
  @@map("knowledge_docs")
}

model ContactForm {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  ipHash      String
  ipAddress   String?
  countryCode String?
  country     String?
  city        String?
  region      String?
  read        Boolean  @default(false)
  replied     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([countryCode])
  @@map("contact_forms")
}

model ContactSettings {
  id                String   @id @default(cuid())
  notificationEmail String?
  blockedKeywords   String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("contact_settings")
}

model BookingSlot {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  time      String
  duration  Int        @default(60)
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  booking   Booking?

  @@unique([date, time])
  @@index([date, status])
  @@map("booking_slots")
}

model Booking {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  notes       String?
  status      BookingStatus @default(PENDING)
  slotId      String?       @unique
  ipHash      String
  ipAddress   String?
  countryCode String?
  country     String?
  city        String?
  region      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  slot        BookingSlot?  @relation(fields: [slotId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([countryCode])
  @@map("bookings")
}

model BookingSettings {
  id                String   @id @default(cuid())
  notificationEmail String?
  reminderEnabled   Boolean  @default(true)
  reminderDay       Int      @default(6)
  reminderTime      String   @default("09:00")
  timezone          String   @default("Asia/Jakarta")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("booking_settings")
}

model BookingAvailability {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
  @@index([dayOfWeek])
  @@index([enabled])
  @@map("booking_availability")
}

model AboutMe {
  id                String   @id @default(cuid())
  fullName          String
  tagline           String
  roles             String[]
  bio               String   @db.Text
  email             String
  phone             String?
  location          String?
  avatarUrl         String?
  resumeUrl         String?
  availabilityStatus String? // "available" | "busy" | "unavailable"
  skills            String[]
  experience        Json?    // Array of experience objects
  socialLinks       Json?    // Array of social link objects
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  location    String
  monthYear   String
  photos      String[]
  description String
  externalUrl String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([visible])
  @@map("achievements")
}

enum UserRole {
  ADMIN
  USER
}

enum ProjectContextType {
  CONTEXT
  ROLE
  DECISIONS
  TRADEOFFS
  RESULT
  ARCHITECTURE
  OPERATIONS
  METRICS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}
