DATABASE_URL=postgresql://portfolio:your_password@localhost:5432/portfolio
DIRECT_URL=${DATABASE_URL}

NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3001

ADMIN_EMAILS=your.email@example.com,admin@example.com
ADMIN_SERVICE_TOKEN=generate_with_openssl_rand_hex_32

NODE_ENV=development
PORT=3001

# Cloudflare R2 credentials from: https://dash.cloudflare.com/ → R2
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=naufalrf-portfolio
R2_PUBLIC_URL=https://pub-[hash].r2.dev/naufalrf-portfolio

# EMAIL SERVICE Get API key from: https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Cloudflare Turnstile - Get keys from: https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key_here
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key_here

# Google Analytics 4
# Get Measurement ID from: https://analytics.google.com/
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mapbox for Geo IP Visualization
# Get access token from: https://www.mapbox.com/account/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# GOOGLE CALENDAR API https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com  # OAuth (different from Analytics)
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# GA4 REPORTING API Service Account JSON credentials from: https://console.cloud.google.com/
# GA_PROPERTY_ID=properties/123456789
# GA_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}  # JSON as string