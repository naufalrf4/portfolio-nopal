# =============================================================================
# Admin App - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This app has direct database access and serves as the API gateway
# =============================================================================

# =============================================================================
# Database Configuration (Direct Access)
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://portfolio:your_password@localhost:5432/portfolio

# Direct connection URL for migrations (required by Neon/Prisma)
DIRECT_URL=${DATABASE_URL}

# =============================================================================
# NextAuth Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# App URL (for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3001

# =============================================================================
# Google OAuth Configuration
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# Admin Access Control
# =============================================================================
# Comma-separated list of admin emails (these users get ADMIN role)
ADMIN_EMAILS=your.email@example.com,admin@example.com

# =============================================================================
# Internal Service Authentication
# =============================================================================
# Token for internal service-to-service communication
# Generate with: openssl rand -hex 32
ADMIN_SERVICE_TOKEN=your_internal_service_token_here

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Redis URL for rate limiting (optional, falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3001
