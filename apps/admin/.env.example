DATABASE_URL=postgresql://portfolio:your_password@localhost:5432/portfolio

NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3001

ADMIN_EMAILS=your.email@example.com,admin@example.com
ADMIN_PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003
ADMIN_INTERNAL_API_TOKEN=generate_with_openssl_rand_hex_32
RAG_INGEST_SERVICE_TOKEN=generate_with_openssl_rand_hex_32
# Legacy fallback shared across two auth directions (outbound admin auth +
# inbound rag ingest auth). Prefer setting ADMIN_INTERNAL_API_TOKEN and
# RAG_INGEST_SERVICE_TOKEN explicitly instead.
# ADMIN_SERVICE_TOKEN=legacy-fallback-only
RAG_SERVICE_URL=http://localhost:3005

NODE_ENV=development
PORT=3001

GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-media-bucket
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-media-bucket
# Optional on GCE with an attached service account; otherwise set one-line JSON credentials.
GCS_SERVICE_ACCOUNT_JSON=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=NaufalRF <noreply@naufalrf.net>

NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key_here
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key_here
# Comma-separated hostnames siteverify must report back. Required whenever
# TURNSTILE_SECRET_KEY is set: an empty list fail-closes every public write.
# Never include localhost/127.0.0.1 in a production deployment.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Lets apps/rag-service call the public bookings/messages POST endpoints
# without a browser-minted Turnstile token, via an X-Service-Token header.
# REQUIRED for that bypass to work: unset means the header can never match
# (fail-closed), so Turnstile stays enforced as normal.
RAG_SERVICE_TOKEN=generate_with_openssl_rand_hex_32

# Google Analytics 4
# Get Measurement ID from: https://analytics.google.com/
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mapbox for Geo IP Visualization
# Get access token from: https://www.mapbox.com/account/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# GOOGLE CALENDAR API https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com  # OAuth (different from Analytics)
# GOOGLE_CLIENT_SECRET=your_client_secret

# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# Demo sign-in bypass (local dev only): when BOTH are set, an extra Credentials
# form appears on /auth/signin. Still restricted to ADMIN_EMAILS. Leave unset in prod.
# DEMO_AUTH_ENABLED=true
# DEMO_AUTH_PASSWORD=some-local-password
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 REPORTING API Service Account JSON credentials from: https://console.cloud.google.com/
# GA_PROPERTY_ID=properties/123456789
# GA_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}  # JSON as string

# Cron authorization. REQUIRED: /api/cron/cleanup-chatlogs rejects every request
# when this is unset (fail-closed).
CRON_SECRET=

# Telegram bot token from @BotFather. REQUIRED for notification dispatch:
# every send fails with 'TELEGRAM_BOT_TOKEN is not configured' when unset.
# Chat IDs are stored per channel in the database, not here.
TELEGRAM_BOT_TOKEN=

# Pepper for IP pseudonymization in submission metadata. Strongly recommended:
# without it, ipHash is an unsalted SHA-256 and is reversible by enumeration.
IP_HASH_SECRET=

# Absolute Admin origin used in booking detail links and email templates.
NEXT_PUBLIC_APP_URL=http://localhost:3001
