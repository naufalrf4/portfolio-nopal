---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  hideFooter?: boolean;
}

const { title, description, ogImage, canonicalUrl, ogType, noindex, hideFooter } = Astro.props;---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  ogType={ogType}
  noindex={noindex}
  hideFooter={hideFooter}
>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
