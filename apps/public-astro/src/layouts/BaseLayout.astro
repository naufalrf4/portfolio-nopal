---
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';
import { getAbout } from '@/lib/api';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { MobileBottomNav } from '../components/layout/MobileBottomNav';
import { ChatWidget } from '../components/chatbot/ChatWidget';
import { LiveCursorBand } from '../components/home/LiveCursorBand';
import { ScrollToTopButton } from '../components/shared/ScrollToTopButton';
import { GlobalScene } from '../components/shared/GlobalScene';

const SITE_NAME = 'NaufalRF Portfolio';
const about = await getAbout();
const sameAs = about.socialLinks.map((link) => link.url);
const twitterProfile = about.socialLinks.find((link) => {
  const platform = link.platform.toLowerCase();
  const url = link.url.toLowerCase();
  return platform === 'twitter' || platform === 'x' || url.includes('twitter.com/') || url.includes('x.com/');
});
const twitterHandle = twitterProfile?.url.split('/').filter(Boolean).pop() || null;

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title: rawTitle,
  description,
  ogImage = '/og-image.png',
  canonicalUrl,
  ogType = 'website'
} = Astro.props;

const title = rawTitle === SITE_NAME ? SITE_NAME : `${rawTitle} - ${SITE_NAME}`;

const currentPath = Astro.url.pathname;
const siteUrl = process.env.SITE_URL?.trim() || import.meta.env.SITE_URL || 'https://naufalrf.net';
const canonical = canonicalUrl || new URL(currentPath, siteUrl).href;
const presenceSocketUrl =
  process.env.PUBLIC_CURSOR_WS_URL?.trim() || import.meta.env.PUBLIC_CURSOR_WS_URL?.trim() || 'ws://localhost:3006/ws';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: about.fullName || 'Naufal Rizqullah Firdaus',
  alternateName: 'NaufalRF',
  description: about.shortBio || about.tagline || description,
  jobTitle: 'System & Automation Engineer',
  knowsAbout: [
    'System Integration Engineering',
    'Automation Engineering',
    'IoT Systems Development',
    'Cloud Infrastructure',
    'AI Workflow Integration',
    'ESP32 MQTT IoT systems',
    'automation workflows with n8n and Python',
    'Next.js Laravel full-stack systems',
    'LangChain and LLM integration',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Depok',
    addressRegion: 'West Java',
    addressCountry: 'Indonesia',
  },
  url: siteUrl,
  sameAs,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: siteUrl,
  description,
};---

<!doctype html>
<html lang="en" class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        function applyTheme() {
          var theme = 'dark';
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') theme = stored;
          } catch (e) {
            
          }
          document.documentElement.dataset.theme = theme;
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="NaufalRF Portfolio" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />

    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle ? <meta name="twitter:site" content={`@${twitterHandle}`} /> : null}
    {twitterHandle ? <meta name="twitter:creator" content={`@${twitterHandle}`} /> : null}
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground min-h-screen" data-page={currentPath === '/' ? 'home' : 'inner'}>
    <div
      id="scroll-progress"
      class="pointer-events-none fixed left-0 right-0 top-0 z-[90] h-[2px] origin-left scale-x-0 bg-teal"
      aria-hidden="true"
    >
    </div>
    <GlobalScene client:load transition:persist />
    <LiveCursorBand client:load currentPath={currentPath} socketUrl={presenceSocketUrl} />
    <ScrollToTopButton client:load currentPath={currentPath} />
    <Navbar />
    <main class="relative z-10 min-h-screen flex flex-col">
      <slot />
    </main>
    <Footer className="relative z-10" />
    <ChatWidget client:load currentPath={currentPath} />
    <MobileBottomNav client:load currentPath={currentPath} />
    <script is:inline>
      (function () {
        function setupReveal() {
          var els = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
          if (!els.length) return;
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced || !('IntersectionObserver' in window)) {
            els.forEach(function (el) {
              el.classList.add('is-revealed');
            });
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        }
        setupReveal();
        document.addEventListener('astro:page-load', setupReveal);

        var progressTicking = false;
        function updateScrollProgress() {
          progressTicking = false;
          var bar = document.getElementById('scroll-progress');
          if (!bar) return;
          var max = document.documentElement.scrollHeight - window.innerHeight;
          var p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          bar.style.transform = 'scaleX(' + p + ')';
        }
        window.addEventListener(
          'scroll',
          function () {
            if (!progressTicking) {
              progressTicking = true;
              requestAnimationFrame(updateScrollProgress);
            }
          },
          { passive: true }
        );
        updateScrollProgress();
        document.addEventListener('astro:page-load', updateScrollProgress);
      })();
    </script>
    <script is:inline>
      {`
        (function () {
          if (typeof window === 'undefined' || typeof document === 'undefined') return;

          const sessionKey = 'public_analytics_session';
          let lastTrackedPage = '';

          function getSessionId() {
            try {
              const existing = window.localStorage.getItem(sessionKey);
              if (existing) return existing;
              const next = 'public-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
              window.localStorage.setItem(sessionKey, next);
              return next;
            } catch {
              return 'public-session';
            }
          }

          function getTimezone() {
            try {
              return Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            } catch {
              return '';
            }
          }

          function sendAnalytics(payload) {
            const body = JSON.stringify(payload);

            if (navigator.sendBeacon) {
              const blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon('/api/analytics', blob);
              return;
            }

            fetch('/api/analytics', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body,
              keepalive: true,
            }).catch(function () {});
          }

          function trackPageView() {
            const page = window.location.pathname || '/';
            const pageKey = page + window.location.search;
            if (pageKey === lastTrackedPage) return;
            lastTrackedPage = pageKey;

            sendAnalytics({
              page,
              eventType: 'pageview',
              entityType: 'page',
              entityId: pageKey,
              userSession: getSessionId(),
              timezone: getTimezone(),
              data: {
                title: document.title,
                url: window.location.href,
              },
            });
          }

          if (!window.__portfolioAnalyticsBound) {
            window.__portfolioAnalyticsBound = true;

            document.addEventListener('click', function (event) {
              const target = event.target;
              if (!(target instanceof Element)) return;

              const button = target.closest('[data-analytics-button]');
              if (button instanceof HTMLElement) {
                sendAnalytics({
                  page: window.location.pathname || '/',
                  eventType: button.dataset.eventType || 'click',
                  entityType: button.dataset.entityType || 'button',
                  entityId: button.dataset.entityId || button.getAttribute('aria-label') || button.textContent?.trim() || 'button',
                  userSession: getSessionId(),
                  timezone: getTimezone(),
                  data: {
                    label: button.dataset.entityLabel || button.getAttribute('aria-label') || button.textContent?.trim() || 'button',
                    url: button.dataset.entityUrl || window.location.href,
                  },
                });
                return;
              }

              const anchor = target.closest('a[href]');
              if (!(anchor instanceof HTMLAnchorElement)) return;

              const rawHref = anchor.getAttribute('href') || '';
              if (!rawHref || rawHref.startsWith('javascript:')) return;

              sendAnalytics({
                page: window.location.pathname || '/',
                eventType: anchor.dataset.eventType || 'click',
                entityType: anchor.dataset.entityType || (anchor.target === '_blank' ? 'outbound_link' : 'link'),
                entityId: anchor.dataset.entityId || rawHref,
                userSession: getSessionId(),
                timezone: getTimezone(),
                data: {
                  label: anchor.dataset.entityLabel || anchor.textContent?.trim() || rawHref,
                  url: anchor.dataset.entityUrl || anchor.href,
                },
              });
            }, { passive: true });

            document.addEventListener('astro:page-load', trackPageView);
          }

          trackPageView();
        })();
      `}
    </script>
  </body>
</html>
