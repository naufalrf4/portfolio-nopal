---
import { NAV_ITEMS, OTHER_LINKS } from '../../lib/constants';
import { ChevronDown, ExternalLink } from 'lucide-react';

const currentPath = Astro.url.pathname;

// Helper to check active state
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 px-4 pt-4 homepage-reveal-soft" style="animation-delay: 0.05s;">
  <nav class="mx-auto max-w-7xl rounded-2xl bg-[#E0E5EC]/80 backdrop-blur-md shadow-[9px_9px_16px_rgb(163,177,198,0.6),-9px_-9px_16px_rgba(255,255,255,0.5)] px-4 md:px-8 homepage-card-hover hover:shadow-[14px_14px_24px_rgba(163,177,198,0.62),-14px_-14px_24px_rgba(255,255,255,0.58)]">
    <div class="flex h-16 items-center justify-between">
      <a
        href="/"
        class="text-xl font-bold text-[#3B82F6] hover:text-[#2563EB] homepage-icon-hover font-display homepage-reveal-soft"
        style="animation-delay: 0.12s;"
      >
        Nau.
      </a>

      <div class="hidden md:flex items-center gap-1 homepage-reveal-soft" style="animation-delay: 0.18s;">
        {NAV_ITEMS.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-nav-href={link.href}
            class:list={[
              'px-4 py-2 rounded-xl text-sm font-medium homepage-pill-hover',
              isActive(link.href)
                ? 'text-[#3B82F6] shadow-[inset_4px_4px_8px_rgba(163,177,198,0.6),inset_-4px_-4px_8px_rgba(255,255,255,0.5)]'
                : 'text-[#3D4852] hover:text-[#3B82F6] hover:shadow-[4px_4px_8px_rgba(163,177,198,0.6),-4px_-4px_8px_rgba(255,255,255,0.5)]'
            ]}
          >
            {link.label}
          </a>
        ))}

        <div class="relative group" id="other-dropdown-container">
          <button
            id="other-dropdown-trigger"
            class:list={[
              'flex items-center gap-1 px-4 py-2 rounded-xl text-sm font-medium homepage-pill-hover',
              'text-[#3D4852] hover:text-[#3B82F6] hover:shadow-[4px_4px_8px_rgba(163,177,198,0.6),-4px_-4px_8px_rgba(255,255,255,0.5)]'
            ]}
            aria-expanded="false"
          >
            Other
            <ChevronDown
              size={16}
              className="transition-transform duration-300 ease-out group-data-[state=open]:rotate-180"
            />
          </button>

          <div 
            id="other-dropdown-menu"
            class="hidden absolute top-full right-0 mt-2 w-56 py-2 rounded-xl bg-[#E0E5EC] shadow-[9px_9px_16px_rgba(163,177,198,0.6),-9px_-9px_16px_rgba(255,255,255,0.5)] homepage-reveal-soft"
          >
            {OTHER_LINKS.map((link) => {
              const Icon = link.icon;
              const isExternal = link.external;
              const active = isActive(link.href);

              return (
                <a
                  href={link.href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  data-nav-link={!isExternal ? true : undefined}
                  data-nav-href={!isExternal ? link.href : undefined}
                  class:list={[
                    'group/item flex items-center gap-3 px-4 py-3 mx-2 rounded-lg text-sm transition-all duration-300 ease-out',
                    active && !isExternal
                      ? 'text-[#3B82F6] shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]'
                      : 'text-[#3D4852] hover:text-[#3B82F6] hover:shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]'
                  ]}
                >
                  <Icon
                    size={18}
                      className="transition-transform duration-300 ease-out group-hover/item:translate-x-0.5 group-hover/item:scale-110"
                  />
                  <span class="flex-1">{link.label}</span>
                  {isExternal && (
                    <ExternalLink
                      size={14}
                       className="text-[#6B7280] transition-all duration-300 ease-out group-hover/item:opacity-100 group-hover/item:translate-x-0.5 opacity-60"
                    />
                  )}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>

  </nav>
</header>

<script>
  interface WindowWithNavbarCleanup extends Window {
    __navbarCleanup?: () => void;
  }

  const desktopActiveClasses = [
    'text-[#3B82F6]',
    'shadow-[inset_4px_4px_8px_rgba(163,177,198,0.6),inset_-4px_-4px_8px_rgba(255,255,255,0.5)]',
  ];
  const desktopInactiveClasses = [
    'text-[#3D4852]',
    'hover:text-[#3B82F6]',
    'hover:shadow-[4px_4px_8px_rgba(163,177,198,0.6),-4px_-4px_8px_rgba(255,255,255,0.5)]',
  ];
  const dropdownActiveClasses = [
    'text-[#3B82F6]',
    'shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]',
  ];
  const dropdownInactiveClasses = [
    'text-[#3D4852]',
    'hover:text-[#3B82F6]',
    'hover:shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]',
  ];
  function isPathActive(pathname: string, href: string) {
    if (href === '/') {
      return pathname === '/';
    }

    return pathname === href || pathname.startsWith(href + '/');
  }

  function syncNavbarActiveState() {
    const pathname = window.location.pathname;
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link][data-nav-href]');

    links.forEach((link) => {
      const href = link.dataset.navHref;
      if (!href) {
        return;
      }

      const active = isPathActive(pathname, href);
      const inDropdown = link.closest('#other-dropdown-menu') !== null;

      if (inDropdown) {
        link.classList.toggle('text-[#3B82F6]', active);
        link.classList.toggle(
          'shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]',
          active
        );
        link.classList.toggle('text-[#3D4852]', !active);
        link.classList.toggle('hover:text-[#3B82F6]', !active);
        link.classList.toggle(
          'hover:shadow-[inset_2px_2px_4px_rgba(163,177,198,0.4),inset_-2px_-2px_4px_rgba(255,255,255,0.4)]',
          !active
        );
      } else {
        desktopActiveClasses.forEach((className) => link.classList.toggle(className, active));
        desktopInactiveClasses.forEach((className) => link.classList.toggle(className, !active));
      }

      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function bindNavbarDropdown() {
    const container = document.getElementById('other-dropdown-container');
    const trigger = document.getElementById('other-dropdown-trigger');
    const menu = document.getElementById('other-dropdown-menu');
    let isOpen = false;
    let hoverTimeout: number | null = null;

    function setOpen(state: boolean) {
      isOpen = state;
      if (state) {
        menu?.classList.remove('hidden');
        trigger?.setAttribute('aria-expanded', 'true');
        trigger?.classList.add('text-[#3B82F6]', 'shadow-[inset_4px_4px_8px_rgba(163,177,198,0.6),inset_-4px_-4px_8px_rgba(255,255,255,0.5)]');
        trigger?.classList.remove('shadow-none');
      } else {
        menu?.classList.add('hidden');
        trigger?.setAttribute('aria-expanded', 'false');
        trigger?.classList.remove('text-[#3B82F6]', 'shadow-[inset_4px_4px_8px_rgba(163,177,198,0.6),inset_-4px_-4px_8px_rgba(255,255,255,0.5)]');
      }
    }

    const handleMouseEnter = () => {
      if (hoverTimeout) clearTimeout(hoverTimeout);
      hoverTimeout = window.setTimeout(() => setOpen(true), 100);
    };

    const handleMouseLeave = () => {
      if (hoverTimeout) clearTimeout(hoverTimeout);
      hoverTimeout = window.setTimeout(() => setOpen(false), 150);
    };

    const handleTriggerClick = (e: Event) => {
      e.stopPropagation();
      setOpen(!isOpen);
    };

    const handleDocumentClick = (e: Event) => {
      if (container && !container.contains(e.target as Node)) {
        setOpen(false);
      }
    };

    const handleDocumentKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setOpen(false);
      }
    };

    container?.addEventListener('mouseenter', handleMouseEnter);
    container?.addEventListener('mouseleave', handleMouseLeave);
    trigger?.addEventListener('click', handleTriggerClick);
    document.addEventListener('click', handleDocumentClick);
    document.addEventListener('keydown', handleDocumentKeydown);

    return () => {
      if (hoverTimeout) clearTimeout(hoverTimeout);
      container?.removeEventListener('mouseenter', handleMouseEnter);
      container?.removeEventListener('mouseleave', handleMouseLeave);
      trigger?.removeEventListener('click', handleTriggerClick);
      document.removeEventListener('click', handleDocumentClick);
      document.removeEventListener('keydown', handleDocumentKeydown);
    };
  }

  const windowWithNavbarCleanup = window as WindowWithNavbarCleanup;

  function refreshNavbarDropdown() {
    windowWithNavbarCleanup.__navbarCleanup?.();
    windowWithNavbarCleanup.__navbarCleanup = bindNavbarDropdown();
    syncNavbarActiveState();
  }

  refreshNavbarDropdown();
  document.addEventListener('astro:page-load', () => {
    refreshNavbarDropdown();
  });
</script>
