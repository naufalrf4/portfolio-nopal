---
import { Github, Linkedin, Twitter, Mail } from 'lucide-react';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://github.com/naufalrf', label: 'GitHub', icon: Github },
  { href: 'https://linkedin.com/in/naufalrf', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://twitter.com/naufalrf', label: 'Twitter', icon: Twitter },
  { href: 'mailto:contact@naufalrf.tech', label: 'Email', icon: Mail },
];

const quickLinks = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blogs', label: 'Blogs' },
  { href: '/ai-chatbot', label: 'AI Assistant' },
  { href: '/contact', label: 'Contact' },
];

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<footer class:list={['relative z-10 bg-transparent py-12 px-4 md:px-8 pb-28 md:pb-12', className]}>
  <div class="mx-auto max-w-7xl">
    <div class="rounded-2xl bg-[#E0E5EC] p-8 shadow-[9px_9px_16px_rgb(163,177,198,0.6),-9px_-9px_16px_rgba(255,255,255,0.5)]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center md:text-left">
          <a
            href="/"
            class="text-2xl font-bold text-[#3B82F6] hover:text-[#2563EB] transition-colors font-display"
          >
            Nau.
          </a>
          <p class="text-sm text-[#6B7280] mt-2 max-w-xs mx-auto md:mx-0">
            Full-Stack Engineer & AI Enthusiast crafting digital experiences with passion.
          </p>
        </div>

        <div class="text-center">
          <h3 class="text-sm font-semibold text-[#3D4852] uppercase tracking-wide mb-4">
            Quick Links
          </h3>
          <div class="flex flex-wrap justify-center gap-3">
            {quickLinks.map((link) => (
              <a
                href={link.href}
                class="px-4 py-2 rounded-xl text-sm text-[#6B7280] hover:text-[#3B82F6] transition-all duration-200 hover:shadow-[4px_4px_8px_rgba(163,177,198,0.6),-4px_-4px_8px_rgba(255,255,255,0.5)]"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <div class="text-center md:text-right">
          <h3 class="text-sm font-semibold text-[#3D4852] uppercase tracking-wide mb-4">
            Connect
          </h3>
          <div class="flex items-center justify-center md:justify-end gap-3">
            {socialLinks.map((link) => {
              const Icon = link.icon;
              return (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 rounded-xl text-[#6B7280] hover:text-[#3B82F6] transition-all duration-200 shadow-[5px_5px_10px_rgb(163,177,198,0.6),-5px_-5px_10px_rgba(255,255,255,0.5)] hover:shadow-[6px_6px_12px_rgb(163,177,198,0.7),-6px_-6px_12px_rgba(255,255,255,0.6)] hover:-translate-y-0.5"
                  aria-label={link.label}
                >
                  <Icon size={20} />
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-[#d1d5db]/50">
        <div class="flex items-center justify-center">
          <p class="text-sm text-[#6B7280]">
            © {currentYear} <span class="text-[#3B82F6] font-medium">Nau.</span> All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
