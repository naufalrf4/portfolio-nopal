---
import PageLayout from '../../layouts/PageLayout.astro';
import { ProjectDetail } from '../../components/project-detail/ProjectDetail';
import { getProjectBySlug } from '../../lib/api';
import { getSiteUrl } from '../../lib/site';
import { formatDate } from '../../lib/utils';

const { slug } = Astro.params;

const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const siteUrl = getSiteUrl();

const lastModified = project.updatedAt;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": project.title,
  "description": project.summary,
  "image": project.imageUrl,
  "datePublished": project.createdAt,
  "dateModified": lastModified,
  "author": {
    "@type": "Person",
    "name": "Naufal Rizqullah Firdaus"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": `${siteUrl}/projects` },
    { "@type": "ListItem", "position": 3, "name": project.title, "item": `${siteUrl}/projects/${project.slug}` },
  ],
};---

<PageLayout
  title={project.title}
  description={project.summary}
  ogImage={project.imageUrl || undefined}
  ogType="article"
>
  <div>
    <ProjectDetail project={project} lastUpdated={formatDate(lastModified)} client:load />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </div>
</PageLayout>

