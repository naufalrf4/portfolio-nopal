---
import PageLayout from '../../layouts/PageLayout.astro';
import { ProjectDetail } from '../../components/project-detail/ProjectDetail';
import { getProjectBySlug } from '../../lib/api';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

let project = null;
let projectUnavailable = false;

try {
  project = await getProjectBySlug(slug);
} catch {
  projectUnavailable = true;
}

if (!projectUnavailable && !project) {
  return Astro.redirect('/404');
}

const articleSchema = project
  ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": project.title,
  "description": project.summary,
  "image": project.imageUrl,
  "datePublished": project.createdAt,
  "author": {
    "@type": "Person",
    "name": "Naufal Rizqullah Fauzan"
  }
}
  : null;

---

<PageLayout
  title={project ? project.title : 'Project Temporarily Unavailable'}
  description={project ? project.summary : 'This project detail is temporarily unavailable while the portfolio reconnects to the Admin API.'}
  ogImage={project?.imageUrl || undefined}
  ogType={project ? 'article' : 'website'}

>
  {project ? (
    <>
      <ProjectDetail project={project} client:load />
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    </>
  ) : (
    <section class="py-24 px-4">
      <div class="mx-auto max-w-3xl rounded-[32px] bg-surface p-10 text-center neu-extruded">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-subtle">Temporary issue</p>
        <h1 class="mb-4 font-display text-3xl font-bold text-foreground">Project detail is temporarily unavailable</h1>
        <p class="mx-auto max-w-xl text-base leading-relaxed text-muted-foreground">
          The project index is still available, but this detail page could not refresh from the Admin API right now.
          Please try again shortly.
        </p>
        <div class="mt-8">
          <a href="/projects" class="inline-flex items-center justify-center rounded-[16px] bg-surface px-6 py-3 text-sm font-medium text-foreground neu-extruded-hover">
            Back to projects
          </a>
        </div>
      </div>
    </section>
  )}
</PageLayout>

