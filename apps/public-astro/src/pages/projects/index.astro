---
import PageLayout from '../../layouts/PageLayout.astro';
import { ProjectsGrid } from '../../components/projects/ProjectsGrid';
import { getProjects } from '../../lib/api';
import { PageHero } from '@/components/shared';

// Fetch all projects for client-side filtering
const { projects } = await getProjects();

const title = "Projects";
const description = 'Explore integrated system projects by Naufal Rizqullah Firdaus across automation engineering, IoT development, cloud-backed software, and AI workflows shaped by real operational constraints.';

---

<PageLayout
  title={title}
  description={description}
  canonicalUrl="https://naufalrf.tech/projects"
>
  <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <PageHero
        eyebrow="Projects"
        title="Things I've built"
        description="A collection of real-world system builds covering software, infrastructure, data flow, automation, and connected devices shaped by practical engineering tradeoffs."
      />

      <ProjectsGrid client:load projects={projects} />
    </div>
  </div>
</PageLayout>
