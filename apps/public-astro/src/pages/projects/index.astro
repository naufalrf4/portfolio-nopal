---
import PageLayout from '../../layouts/PageLayout.astro';
import { ProjectsGrid } from '../../components/projects/ProjectsGrid';
import { getProjects } from '../../lib/api';
import { FolderKanban } from 'lucide-react';
import { PageHero } from '@/components/shared';

// Fetch all projects for client-side filtering
const { projects } = await getProjects();

const title = "Projects";
const description = 'Explore case studies focused on real product goals, delivery tradeoffs, and the problems each build was meant to solve.';

---

<PageLayout
  title={title}
  description={description}
  canonicalUrl="https://naufalrf.tech/projects"
>
  <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <PageHero
        icon={FolderKanban}
        title={title}
        description="A collection of product, platform, and automation work shaped by real constraints, real users, and practical engineering tradeoffs."
      />

      <ProjectsGrid client:load projects={projects} />
    </div>
  </div>
</PageLayout>
