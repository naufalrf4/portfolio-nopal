---
import PageLayout from '../layouts/PageLayout.astro';
import { AboutContent } from '../components/about/AboutContent';
import { getAbout, getAchievements } from '../lib/api';

const [about, achievementsData] = await Promise.all([getAbout(), getAchievements()]);

const title = "About";
const description = "Learn how Naufal Rizqullah Firdaus approaches engineering as a System & Automation Engineer and Computer Engineering student at IPB University (Institut Pertanian Bogor), building integrated systems across software, cloud, IoT, and AI from Depok in the Jabodetabek region.";
---

<PageLayout
  title={title}
  description={description}
  canonicalUrl="/about"
  ogType="profile"
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <AboutContent client:load about={about} achievements={achievementsData.achievements} />
  </div>
</PageLayout>
