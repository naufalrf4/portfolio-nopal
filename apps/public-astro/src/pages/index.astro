---
import PageLayout from '../layouts/PageLayout.astro';
import { HeroSection } from '../components/home/HeroSection';
import { FeaturedProjects } from '../components/home/FeaturedProjects';
import { Guestbook } from '../components/home/Guestbook';
import { LatestArticles } from '../components/home/LatestArticles';
import { TechnicalExpertise } from '../components/home/TechnicalExpertise';
import { getAbout, getProjects, getBlogs, getGuestbookEntries } from '../lib/api';

const [about, projectsData, blogsData, guestbookData] = await Promise.all([
  getAbout(),
  getProjects({ featured: true, limit: 3 }),
  getBlogs(3),
  getGuestbookEntries(),
]);
const turnstileSiteKey =
  process.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ||
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ||
  '';

const title = 'NaufalRF Portfolio';
const description =
  'Naufal Rizqullah Firdaus is a System & Automation Engineer and Computer Engineering student at IPB University (Institut Pertanian Bogor) based in Depok, building integrated systems across software, cloud, IoT, and AI workflows for real-world operations in Indonesia and beyond.';

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NaufalRF Portfolio',
  url: 'https://naufalrf.tech',
  description:
    'The personal portfolio of Naufal Rizqullah Firdaus featuring system integration engineering, automation workflows, IoT development, cloud infrastructure, and AI-driven systems built for real-world operational use.',
  author: {
    '@type': 'Person',
    name: 'Naufal Rizqullah Firdaus',
    alternateName: 'NaufalRF',
  },
};

const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Naufal Rizqullah Firdaus',
  alternateName: 'NaufalRF',
  url: 'https://naufalrf.tech',
  jobTitle: ['System & Automation Engineer', 'Automation Engineer', 'IoT System Developer'],
  description:
    'System & Automation Engineer from Depok, Indonesia focused on building integrated systems across software, cloud infrastructure, IoT devices, and AI-driven workflows.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Depok',
    addressRegion: 'West Java',
    addressCountry: 'ID',
  },
  knowsAbout: [
    'System Integration Engineering',
    'Automation Engineering',
    'IoT Systems Development',
    'ESP32 MQTT IoT systems',
    'automation workflows with n8n and Python',
    'cloud-based system architecture on AWS',
    'AI integration with LangChain and LLM systems',
    'Next.js Laravel full-stack systems',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'IPB University',
    alternateName: 'Institut Pertanian Bogor',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Open to opportunities',
  },
  sameAs: about.socialLinks.map((link) => link.url),
};
---

<PageLayout title={title} description={description}>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Naufal Rizqullah Firdaus, NaufalRF, System & Automation Engineer, system integration engineer portfolio, automation engineer Indonesia, IoT system developer, AI workflow engineer, real-time system developer, IPB University, Institut Pertanian Bogor, Teknik Komputer, Computer Engineering, Depok, Bogor, Jakarta, Jabodetabek, ESP32 MQTT IoT system, automation workflows n8n Python, cloud-based system architecture AWS, Next.js Laravel full-stack system, AI integration LangChain LLM, Digistar Club by Telkom Indonesia"
    />
    <meta name="author" content="Naufal Rizqullah Firdaus" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(personStructuredData)} />
  </Fragment>

  <HeroSection client:load about={about} />
  <TechnicalExpertise client:visible />
  <FeaturedProjects client:load projects={projectsData.projects} />
  <LatestArticles client:visible blogs={blogsData.blogs} />
  <Guestbook client:load initialEntries={guestbookData.entries} turnstileSiteKey={turnstileSiteKey} />
</PageLayout>
