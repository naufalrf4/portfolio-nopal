---
import { PageHero } from '@/components/shared';
import PageLayout from '@/layouts/PageLayout.astro';
import { getAboutSafe } from '@/lib/api';
import {
  Network,
  Cpu,
  Workflow,
  Sparkles,
  Mic,
  Users,
  ArrowRight,
  Download,
  ArrowUpRight,
} from 'lucide-react';

// Services page renders fine even without profile data (availability status,
// resume link are optional enhancements), so this uses the non-throwing
// safe variant rather than 503-ing the whole page when the Admin API is
// unreachable - same reasoning as contact.astro.
const about = await getAboutSafe();

const title = 'Services';
const description =
  'How to work with Naufal Rizqullah Firdaus: system integration, IoT builds, automation, and AI engineering, plus talks and mentoring.';

const AVAILABILITY_COPY: Record<string, { label: string; dotClass: string; pulse: boolean }> = {
  available: { label: 'Open to new work', dotClass: 'bg-green', pulse: true },
  busy: { label: 'Deep in something right now', dotClass: 'bg-amber', pulse: false },
  unavailable: { label: 'Not taking new engagements', dotClass: 'bg-text-tertiary', pulse: false },
};

const availability = about.availabilityStatus ? AVAILABILITY_COPY[about.availabilityStatus] : null;

const technicalServices = [
  {
    icon: Network,
    title: 'System Integration',
    description:
      'APIs, cloud infrastructure, and full-stack systems wired together into one working pipeline, backed by AWS-based architecture.',
  },
  {
    icon: Cpu,
    title: 'IoT & Hardware Builds',
    description:
      'ESP32 sensor networks over MQTT, built into telemetry and control systems that run in the field, not just on a breadboard.',
  },
  {
    icon: Workflow,
    title: 'Automation Workflows',
    description: 'n8n and Python scripts that take over the manual steps in a process, end to end.',
  },
  {
    icon: Sparkles,
    title: 'AI Integration',
    description:
      'LangChain and LLM systems grounded in real data, built to answer for a product rather than a demo.',
  },
];

const beyondTheCode = [
  {
    icon: Mic,
    title: 'Speaking',
    description: 'Talks on automation, IoT, and AI systems for campus and community events.',
  },
  {
    icon: Users,
    title: 'Mentoring',
    description: "1:1 or group guidance for students building their first real systems.",
  },
];

const engagementTypes = [
  'Freelance',
  'Contract',
  'Full-time',
  'Remote',
  'Speaking engagement',
  'Mentoring',
];
---

<PageLayout title={title} description={description}>
  <div class="py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <PageHero
        eyebrow="Availability"
        title="Ways to work with me"
        description="System integration, IoT builds, and AI workflows when something needs building. Talks and mentoring when something needs explaining."
      />

      {
        availability && (
          <div class="-mt-6 mb-14 flex homepage-reveal-soft md:-mt-10" style={{ animationDelay: '0.2s' }}>
            <div class="inline-flex items-center gap-2.5 rounded-full border border-line bg-bg-elevated px-4 py-2">
              <span
                class:list={[
                  'h-2 w-2 rounded-full',
                  availability.dotClass,
                  availability.pulse && 'status-dot',
                ]}
              />
              <span class="font-mono text-xs uppercase tracking-wider text-text-secondary">
                {availability.label}
              </span>
            </div>
          </div>
        )
      }

      {/* Technical services */}
      <section aria-labelledby="technical-services-heading" class="mb-20 md:mb-28">
        <h2 id="technical-services-heading" class="mb-8 text-2xl font-bold text-text-primary md:text-3xl">
          What I build
        </h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            technicalServices.map((service) => (
              <a
                href="/projects"
                class="card-base card-glow-hover group flex h-full flex-col p-6"
              >
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-bg-elevated text-teal">
                  <service.icon size={20} strokeWidth={1.75} />
                </div>
                <h3 class="mb-2 text-lg font-bold text-text-primary transition-colors group-hover:text-teal">
                  {service.title}
                </h3>
                <p class="flex-1 text-sm leading-relaxed text-text-secondary">{service.description}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
                  See related work
                  <ArrowUpRight
                    size={14}
                    class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </a>
            ))
          }
        </div>
        {/*
          Project listing does not support faceted tech filtering (no `?tech=`
          query handling in ProjectsGrid), so each card links to the general
          /projects index rather than a filtered view.
        */}
      </section>

      {/* Beyond the code */}
      <section aria-labelledby="beyond-code-heading" class="mb-20 md:mb-28">
        <h2 id="beyond-code-heading" class="mb-8 text-2xl font-bold text-text-primary md:text-3xl">
          Beyond the code
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            beyondTheCode.map((offer) => (
              <div class="card-base flex h-full flex-col p-6 md:p-8">
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-bg-elevated text-amber">
                  <offer.icon size={20} strokeWidth={1.75} />
                </div>
                <h3 class="mb-2 text-lg font-bold text-text-primary">{offer.title}</h3>
                <p class="flex-1 text-sm leading-relaxed text-text-secondary">{offer.description}</p>
                <a
                  href="/about"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-teal transition-colors hover:text-amber"
                >
                  More on my background
                  <ArrowUpRight size={14} />
                </a>
              </div>
            ))
          }
        </div>
      </section>

      {/* Engagement types */}
      <section aria-labelledby="engagement-heading" class="mb-20 md:mb-28">
        <h2 id="engagement-heading" class="mb-6 text-2xl font-bold text-text-primary md:text-3xl">
          Open to
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {
            engagementTypes.map((type) => (
              <span class="mono-tag !text-xs">{type}</span>
            ))
          }
        </div>
      </section>

      {/* Cross-links */}
      <section aria-label="More links" class="mb-16 flex flex-col gap-3 border-t border-line pt-8 text-sm md:mb-20">
        <p class="text-text-secondary">
          Want the full background?{' '}
          <a href="/about" class="font-medium text-teal transition-colors hover:text-amber">
            Read the story
          </a>
        </p>
        {
          about.resumeUrl && (
            <p class="text-text-secondary">
              Need the CV file?{' '}
              <a
                href={about.resumeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-medium text-teal transition-colors hover:text-amber"
              >
                Download it here
                <Download size={13} />
              </a>
            </p>
          )
        }
      </section>

      {/* CTA band */}
      <section class="card-base flex flex-col items-start gap-5 p-8 md:flex-row md:items-center md:justify-between md:p-10">
        <div>
          <h2 class="text-2xl font-bold text-text-primary md:text-3xl">Have something in mind?</h2>
          <p class="mt-2 max-w-xl text-text-secondary">
            Tell me what you're trying to build, run, or explain. I'll tell you if it's something I can help with.
          </p>
        </div>
        <a href="/contact" class="shrink-0">
          <button
            type="button"
            class="group inline-flex items-center gap-2 rounded-lg border border-transparent bg-teal px-6 py-3 text-base font-semibold text-bg transition-all duration-300 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:shadow-[0_8px_24px_-8px_var(--teal-glow)] active:translate-y-0"
          >
            Send a message
            <ArrowRight size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
          </button>
        </a>
      </section>
    </div>
  </div>
</PageLayout>
