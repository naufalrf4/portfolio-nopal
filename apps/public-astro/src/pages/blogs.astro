---
import { NotebookPen } from 'lucide-react';
import { BlogsContent } from '@/components/blogs';
import { PageHero } from '@/components/shared';
import PageLayout from '@/layouts/PageLayout.astro';
import { getBlogs } from '@/lib/api';

const { blogs } = await getBlogs();

const title = 'Blog & Articles';
const description =
  'Browse writing I have published myself plus references, interviews, and external posts connected to my work.';
---

<PageLayout title={title} description={description}>
  <div class="min-h-screen px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHero
        icon={NotebookPen}
        title="Writing & Mentions"
        description="A mixed shelf of articles I have written, technical notes I have published, and a few places where my work or perspective is featured."
      />

      <BlogsContent initialBlogs={blogs} client:load />
    </div>
  </div>
</PageLayout>
