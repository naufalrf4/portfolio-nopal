---
import { BlogsContent } from '@/components/blogs';
import { PageHero } from '@/components/shared';
import PageLayout from '@/layouts/PageLayout.astro';
import { getBlogs } from '@/lib/api';

const { blogs } = await getBlogs();

const title = 'Blog & Articles';
const description =
  'Browse writing, technical notes, and system-design insights from Naufal Rizqullah Firdaus on automation, IoT, cloud-backed software, AI workflows, and practical engineering in Indonesia.';
---

<PageLayout title={title} description={description}>
  <div class="min-h-screen px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHero
        eyebrow="Writing"
        title="Notes & articles"
        description="A mixed shelf of engineering notes, practical tutorials, and system-thinking writeups around automation, IoT, cloud systems, and AI integration."
      />

      <BlogsContent initialBlogs={blogs} client:load />
    </div>
  </div>
</PageLayout>
