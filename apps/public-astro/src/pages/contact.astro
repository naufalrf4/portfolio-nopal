---
import PageLayout from '../layouts/PageLayout.astro';
import { ContactContent } from '../components/contact/ContactContent';
import { getAbout } from '../lib/api';

const aboutData = await getAbout();

const title = "Contact";
const description = "Get in touch with Naufal RF for freelance projects, job opportunities, or collaboration. Available for full-time positions and consulting work.";

---

<PageLayout title={title} description={description}>
  <div class="pt-20 md:pt-24">
    <ContactContent client:load aboutData={aboutData} />
  </div>
</PageLayout>
