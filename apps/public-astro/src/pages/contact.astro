---
import { MessagesSquare } from 'lucide-react';
import { ContactContent } from '../components/contact/ContactContent';
import { PageHero } from '../components/shared';
import PageLayout from '../layouts/PageLayout.astro';
import { getAbout } from '../lib/api';

const aboutData = await getAbout();

const title = 'Contact';
const description =
  'Get in touch with Naufal RF for freelance projects, job opportunities, or collaboration. Available for full-time positions and consulting work.';
---

<PageLayout title={title} description={description}>
  <div class="pt-20 md:pt-24">
    <div class="px-4 pt-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <PageHero
          icon={MessagesSquare}
          title="Get in Touch"
          description="Send a direct message or reserve a call slot for projects, consulting, collaboration, or full-time opportunities."
        />
      </div>
    </div>
    <ContactContent client:load aboutData={aboutData} />
  </div>
</PageLayout>
