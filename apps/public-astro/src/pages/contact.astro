---
import { ContactContent } from '../components/contact/ContactContent';
import { PageHero } from '../components/shared';
import PageLayout from '../layouts/PageLayout.astro';
import { getAbout } from '../lib/api';

const aboutData = await getAbout();
const turnstileSiteKey =
  process.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ||
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ||
  '';

const title = 'Contact';
const description =
  'Reach out to Naufal Rizqullah Firdaus for system integration, automation, IoT, cloud, or AI workflow conversations, hiring, collaboration, speaking, and engineering opportunities across Indonesia or remote teams.';---

<PageLayout title={title} description={description}>
  <div class="px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHero
        eyebrow="Get in touch"
        title="Let's build something"
        description="Send a direct message, ask a question, or book a call about integrated systems, automation workflows, IoT platforms, AI-enabled operations, speaking, or collaboration opportunities."
      />
    </div>
    <ContactContent client:load aboutData={aboutData} turnstileSiteKey={turnstileSiteKey} />
  </div>
</PageLayout>
