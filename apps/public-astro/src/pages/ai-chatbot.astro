---
import { PageHero } from '@/components/shared';
import PageLayout from '../layouts/PageLayout.astro';
import { ChatWindow } from '../components/chatbot/ChatWindow';

const title = "AI Assistant";
const description = 'Chat with Nau AI about Naufal Rizqullah Firdaus, his System & Automation Engineer profile, projects, IPB University background, automation systems, IoT builds, AI workflows, and practical engineering work.';---

<PageLayout title={title} description={description}>
  <section class="px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHero
        eyebrow="AI Assistant"
        title="Ask me anything"
        description="Ask about my system design approach, projects, automation workflows, IoT systems, AI integration work, or general questions in the same language you use."
        centered
      />

      <div class="homepage-reveal" style="animation-delay:0.22s">
        <ChatWindow
          client:load
          isFullPage={true}
          className="mx-auto h-[72vh] min-h-[620px] max-w-3xl"
        />
      </div>
    </div>
  </section>
</PageLayout>
