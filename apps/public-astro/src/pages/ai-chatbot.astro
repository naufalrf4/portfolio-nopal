---
import { Sparkles } from 'lucide-react';
import { PageHero } from '@/components/shared';
import PageLayout from '../layouts/PageLayout.astro';
import { ChatWindow } from '../components/chatbot/ChatWindow';

const title = "AI Assistant";
const description = 'Chat with Nau AI about my work, broader topics, and whatever is on your mind in a natural conversation.';
---

<PageLayout title={title} description={description}>
  <section class="px-4 py-12 md:px-6 md:py-16">
    <div class="mx-auto max-w-7xl">
      <PageHero
        icon={Sparkles}
        title="AI Assistant"
        description="Talk with Nau AI about portfolio details, general knowledge, or casual questions in the same language you use."
        className="homepage-reveal"
      />

      <div class="homepage-reveal" style="animation-delay:0.22s">
        <ChatWindow
          client:load
          isFullPage={true}
          className="mx-auto h-[72vh] min-h-[620px] max-w-[1100px]"
        />
      </div>
    </div>
  </section>
</PageLayout>
