# Environment Variables for public-astro

# Admin Service API (for SSR data fetching)
ADMIN_API_URL=http://localhost:3001

# Public Site Configuration
PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile public site key for guestbook and other public forms
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key_here

# Internal RAG Service URL used by the local Astro API proxy for chatbot requests
RAG_SERVICE_URL=http://localhost:3005

# Realtime cursor presence websocket URL
PUBLIC_CURSOR_WS_URL=ws://localhost:3006/ws

SITE_URL=https://naufalrf.tech
