# =============================================================================
# Links Hub - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This app consumes Admin API for profile links
# =============================================================================

# =============================================================================
# Admin API Configuration
# =============================================================================
# URL to the Admin app API
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api

# Internal API URL (for server-side requests)
ADMIN_API_URL=http://localhost:3001/api

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3002

# Site metadata
NEXT_PUBLIC_SITE_NAME="NaufalRF Links"
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_DESCRIPTION="All my links in one place"

# Profile information
NEXT_PUBLIC_PROFILE_NAME="NaufalRF"
NEXT_PUBLIC_PROFILE_BIO="Full-Stack Engineer | Building scalable web apps"
NEXT_PUBLIC_PROFILE_IMAGE="/avatar.jpg"
