# =============================================================================
# Public Portfolio - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This app consumes Admin API for data
# =============================================================================

# =============================================================================
# Admin API Configuration
# =============================================================================
# URL to the Admin app API
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api

# Internal API URL (for server-side requests)
ADMIN_API_URL=http://localhost:3001/api

# =============================================================================
# NextAuth Configuration (for Guestbook)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# App URL (for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# Google OAuth Configuration (for Guestbook)
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# RAG Chatbot Configuration
# =============================================================================
# URL to the RAG service
NEXT_PUBLIC_RAG_SERVICE_URL=http://localhost:3004

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3000

# Site metadata
NEXT_PUBLIC_SITE_NAME="NaufalRF Portfolio"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION="Full-Stack Engineer specializing in scalable web applications"
