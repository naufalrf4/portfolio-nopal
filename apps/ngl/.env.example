# =============================================================================
# NGL (Anonymous Feedback) - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This app allows anonymous messages via Admin API
# =============================================================================

# =============================================================================
# Admin API Configuration
# =============================================================================
# URL to the Admin app API
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api

# Internal API URL (for server-side requests)
ADMIN_API_URL=http://localhost:3001/api

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3003

# Site metadata
NEXT_PUBLIC_SITE_NAME="Send me an anonymous message"
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_SITE_DESCRIPTION="Share your thoughts anonymously"

# Rate limiting
NEXT_PUBLIC_MAX_MESSAGE_LENGTH=500
NEXT_PUBLIC_RATE_LIMIT_MESSAGES_PER_HOUR=5
