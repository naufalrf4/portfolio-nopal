# =============================================================================
# RAG Service - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This is a Node.js/Fastify service for AI chatbot with RAG
# =============================================================================

# =============================================================================
# Admin API Configuration (for fetching content and logging)
# =============================================================================
# URL to the Admin app API
ADMIN_API_URL=http://localhost:3001/api

# Service token for internal authentication
ADMIN_SERVICE_TOKEN=your_internal_service_token_here

# =============================================================================
# Qdrant Configuration
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# Collection configuration
QDRANT_COLLECTION_NAME=portfolio_embeddings
QDRANT_VECTOR_SIZE=1536

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Primary LLM provider (options: gemini, groq, openai, deepseek)
PRIMARY_LLM=gemini

# Fallback LLM provider (used if primary fails)
FALLBACK_LLM=groq

# =============================================================================
# LLM API Keys
# =============================================================================
# OpenAI API Key (for embeddings and optionally chat)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini API Key (for chat)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for chat - fast inference)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Key (for chat - alternative)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =============================================================================
# Embedding Configuration
# =============================================================================
# Embedding model (OpenAI text-embedding-3-small = 1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# RAG Configuration
# =============================================================================
# Number of similar documents to retrieve
RAG_TOP_K=5

# Minimum similarity score (0-1)
RAG_SIMILARITY_THRESHOLD=0.7

# Maximum context length for LLM
RAG_MAX_CONTEXT_LENGTH=4000

# =============================================================================
# Session Configuration
# =============================================================================
# Session memory TTL in seconds (default: 1 hour)
SESSION_TTL=3600

# Maximum messages to keep in session history
MAX_SESSION_MESSAGES=20

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3004

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Enable debug logging
DEBUG=true
