APP_ENV=development
HOST=0.0.0.0
PORT=3005
LOG_LEVEL=INFO

RAG_DATABASE_URL=postgresql+asyncpg://<same-admin-db-user>:<same-admin-db-password>@<same-admin-db-host>/<same-admin-db-name>?ssl=require
ADMIN_API_URL=http://localhost:3001
ADMIN_SERVICE_TOKEN=replace-me
GEMINI_API_KEY=replace-me
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
CHAT_MODEL=gemini-2.5-flash
CONTEXT_MODEL=gemini-2.5-flash
ADMIN_API_TIMEOUT_MS=5000
