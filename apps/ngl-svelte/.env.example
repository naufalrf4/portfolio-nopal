# Environment Variables for ngl-svelte

# Admin Service API (for form submission server action)
ADMIN_API_URL=http://localhost:3001
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key_here
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CURSOR_WS_URL=ws://localhost:3006/ws

# Service token for shipping logs to the Admin internal log endpoint.
# Server-side only — never expose this under a PUBLIC_ prefix.
ADMIN_INTERNAL_API_TOKEN=generate_with_openssl_rand_hex_32
