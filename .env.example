# =============================================================================
# NaufalRF Portfolio - Root Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# This file is used by Docker Compose for local development
# =============================================================================

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# Connection URLs (auto-generated from above)
# For Prisma: postgresql://user:password@localhost:5432/database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Direct URL for migrations (required by Neon/Prisma)
DIRECT_URL=${DATABASE_URL}

# =============================================================================
# Qdrant Vector Database Configuration
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# Collection configuration
QDRANT_COLLECTION_NAME=portfolio_embeddings
QDRANT_VECTOR_SIZE=1536

# =============================================================================
# Development Ports (apps run on these ports locally)
# =============================================================================
PUBLIC_PORT=3000
ADMIN_PORT=3001
LINKS_PORT=3002
NGL_PORT=3003
RAG_SERVICE_PORT=3004
