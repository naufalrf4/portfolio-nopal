# Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DIRECT_URL=${DATABASE_URL}

# ============================================
# QDRANT VECTOR DATABASE
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}
QDRANT_COLLECTION_NAME=portfolio_embeddings
QDRANT_VECTOR_SIZE=1536

# ============================================
# APPLICATION PORTS
# ============================================
PUBLIC_PORT=3000
ADMIN_PORT=3001
LINKS_PORT=3002
NGL_PORT=3003
RAG_SERVICE_PORT=3004

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# ADMIN APP CONFIGURATION
# ============================================
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_URL=https://admin.yourdomain.com

ADMIN_EMAILS=admin@yourdomain.com
ADMIN_SERVICE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ============================================
# CLOUDFLARE R2 STORAGE
# ============================================
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=naufalrf-portfolio
R2_PUBLIC_URL=https://pub-[hash].r2.dev/naufalrf-portfolio

# ============================================
# EMAIL SERVICE (RESEND)
# ============================================
RESEND_API_KEY=re_CHANGE_ME

# ============================================
# CLOUDFLARE TURNSTILE
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_CHANGE_ME
TURNSTILE_SECRET_KEY=0x4AAAAAAA_CHANGE_ME

# ============================================
# MAPBOX (OPTIONAL)
# ============================================
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.CHANGE_ME

# ============================================
# GOOGLE ANALYTICS (OPTIONAL)
# ============================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_PROPERTY_ID=properties/123456789
# GA_SERVICE_ACCOUNT={"type":"service_account",...}

# ============================================
# PUBLIC APP CONFIGURATION
# ============================================
NEXT_PUBLIC_ADMIN_API_URL=https://admin.yourdomain.com/api
ADMIN_API_URL=http://admin:3001/api
PUBLIC_NEXTAUTH_URL=https://yourdomain.com

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ============================================
# RAG SERVICE (OPTIONAL)
# ============================================
NEXT_PUBLIC_RAG_SERVICE_URL=https://rag.yourdomain.com

# ============================================
# GOOGLE CALENDAR API (OPTIONAL)
# ============================================
# GOOGLE_REDIRECT_URI=https://admin.yourdomain.com/api/auth/callback/google
# GOOGLE_REFRESH_TOKEN=CHANGE_ME
