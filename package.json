{
  "name": "naufalrf-portfolio",
  "private": true,
  "description": "Meta repository for standalone apps under apps/*",
  "scripts": {
    "dev:all": "bash ./start-dev.sh",
    "reset:seed": "bash ./scripts/docker-dev-reset-seed.sh",
    "docker:dev": "bash ./scripts/docker-dev-up.sh",
    "docker:dev:down": "bash ./scripts/docker-dev-down.sh",
    "docker:dev:migrate": "bash ./scripts/docker-dev-migrate.sh",
    "docker:dev:seed": "bash ./scripts/docker-dev-seed.sh",
    "docker:dev:reset-seed": "bash ./scripts/docker-dev-reset-seed.sh",
    "docker:prod": "bash ./scripts/docker-prod-up.sh",
    "docker:prod:migrate": "bash ./scripts/docker-prod-migrate.sh",
    "docker:prod:bootstrap": "bash ./scripts/docker-prod-bootstrap.sh",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "dev": "bash ./start-dev.sh",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 bun run --filter admin build && bun run --filter slidedeck build && bash scripts/sync-slidedeck.sh && bun run --filter public-astro build && bun run --filter links-astro build && bun run --filter ngl-svelte build && bun run --filter rag-service build",
    "lint": "bun run --filter admin lint && bun run --filter ngl-svelte lint",
    "typecheck": "bun run --filter admin typecheck && bun run --filter ngl-svelte check && bun run --filter rag-service typecheck",
    "test:e2e": "bun run e2e/runner.ts",
    "test:e2e:specs": "bun test e2e/features"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "lint-staged": "^16.2.6",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ]
}
