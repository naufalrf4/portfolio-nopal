{
  "name": "naufalrf-portfolio",
  "private": true,
  "description": "Integration repository for pinned standalone apps",
  "scripts": {
    "dev:all": "bash ./start-dev.sh",
    "reset:seed": "bash ./scripts/docker-dev-reset-seed.sh",
    "docker:dev": "bash ./scripts/docker-dev-up.sh",
    "docker:dev:down": "bash ./scripts/docker-dev-down.sh",
    "docker:dev:migrate": "bash ./scripts/docker-dev-migrate.sh",
    "docker:dev:seed": "bash ./scripts/docker-dev-seed.sh",
    "docker:dev:reset-seed": "bash ./scripts/docker-dev-reset-seed.sh",
    "docker:prod": "bash ./scripts/docker-prod-up.sh",
    "docker:prod:migrate": "bash ./scripts/docker-prod-migrate.sh",
    "docker:prod:bootstrap": "bash ./scripts/docker-prod-bootstrap.sh",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "dev": "bash ./start-dev.sh",
    "install:apps": "bash ./scripts/install-apps.sh",
    "build:all": "bash ./scripts/build-apps.sh",
    "build:admin": "cd apps/admin && bun run build",
    "build:public": "cd apps/public-astro && bun run build",
    "build:links": "cd apps/links-astro && bun run build",
    "build:ngl": "cd apps/ngl-svelte && bun run build",
    "build:rag": "cd apps/rag-service && bun run build",
    "lint:admin": "cd apps/admin && bun run lint",
    "lint:ngl": "cd apps/ngl-svelte && bun run lint",
    "typecheck:admin": "cd apps/admin && bun run typecheck",
    "typecheck:ngl": "cd apps/ngl-svelte && bun run check",
    "typecheck:rag": "cd apps/rag-service && bun run typecheck",
    "test:e2e": "bun run e2e/runner.ts",
    "test:e2e:specs": "bun test e2e/features"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "lint-staged": "^16.2.6",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "e2e"
  ]
}
