COMPOSE_PROJECT_NAME=portfolio-nopal-prod

CADDY_EMAIL=ops@example.com
PUBLIC_DOMAIN=portfolio.example.com
ADMIN_DOMAIN=admin.example.com
LINKS_DOMAIN=links.example.com
NGL_DOMAIN=ngl.example.com
PRESENCE_DOMAIN=presence.example.com

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-strong-password

ADMIN_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
ADMIN_PUBLIC_URL=https://admin.example.com
ADMIN_AUTH_TRUST_HOST=true
ADMIN_EMAILS=you@example.com,admin@example.com
ADMIN_PUBLIC_API_ALLOWED_ORIGINS=https://portfolio.example.com,https://links.example.com,https://ngl.example.com
ADMIN_INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32
ADMIN_CRON_SECRET=replace-with-openssl-rand-hex-32
# Daily run time for the admin-cron sidecar, HH:MM in Asia/Jakarta.
ADMIN_CRON_AT=02:00
RAG_INGEST_SERVICE_TOKEN=replace-with-openssl-rand-hex-32
# Legacy fallback shared across two auth directions (outbound admin auth +
# inbound rag ingest auth). Prefer setting ADMIN_INTERNAL_API_TOKEN and
# RAG_INGEST_SERVICE_TOKEN explicitly instead.
# ADMIN_SERVICE_TOKEN=legacy-fallback-only
ADMIN_GCS_PROJECT_ID=replace-with-gcp-project-id
ADMIN_GCS_BUCKET_NAME=media.naufalrf.net
ADMIN_GCS_PUBLIC_BASE_URL=https://media.naufalrf.net
ADMIN_GCS_SERVICE_ACCOUNT_JSON=
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=NaufalRF <noreply@naufalrf.net>
ADMIN_NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me
ADMIN_TURNSTILE_SECRET_KEY=replace-me
# Comma-separated hostnames siteverify must report back, bare hostnames with no
# scheme or port. Must NOT contain localhost/127.0.0.1 in production. Only the
# apps that mint tokens belong here: public-astro (naufalrf.net) and ngl.
ADMIN_TURNSTILE_HOSTNAMES=naufalrf.net,ngl.naufalrf.net
ADMIN_NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=replace-me
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_REDIRECT_URI=https://admin.example.com/api/auth/callback/google
ADMIN_NEXT_PUBLIC_GA_MEASUREMENT_ID=
ADMIN_GOOGLE_REFRESH_TOKEN=

ADMIN_GA_PROPERTY_ID=
ADMIN_GA_SERVICE_ACCOUNT=

PUBLIC_SITE_URL=https://portfolio.example.com
PUBLIC_TURNSTILE_SITE_KEY=replace-me
PUBLIC_SITE_CANONICAL_URL=https://portfolio.example.com
PRESENCE_PUBLIC_WS_URL=wss://presence.example.com/ws
PRESENCE_ALLOWED_ORIGINS=https://portfolio.example.com

LINKS_SITE_URL=https://links.example.com

NGL_PUBLIC_TURNSTILE_SITE_KEY=replace-me
NGL_PUBLIC_GA_MEASUREMENT_ID=

RAG_OPENAI_API_KEY=replace-me
RAG_LOG_LEVEL=INFO
RAG_CORS_ORIGINS=["https://portfolio.example.com"]
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_CONTEXT_MODEL=gemini-2.5-flash
RAG_ADMIN_API_TIMEOUT_MS=5000
RAG_CHUNK_TARGET_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_INGESTION_BATCH_SIZE=32
RAG_RETRIEVAL_LIMIT=5
RAG_CHAT_HISTORY_LIMIT=6
